PORT=4000
# the backend serves the PC UI at / (same origin as /api), so this is the backend's own url
FRONTEND_URL=http://localhost:4000
# SERVE_FRONTEND=true
# FRONTEND_DIR=../frontend/UI/PC UI
# more allowed origins for local dev, comma separated (e.g. VS Code Live Server)
CORS_ORIGINS=

# https://aistudio.google.com/apikey
# use a paid (billing-enabled) key in production - the free tier may use prompts to improve Google's models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=60000

# non-AI requests (AI routes get longer, chat has none)
REQUEST_TIMEOUT_MS=15000
# reuse an AI answer for this many days if nothing changed. 0 = off
AI_CACHE_DAYS=7

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# never ship this to the frontend, it bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=
# check login tokens here with the project's public keys (JWKS) instead of asking Supabase every request
AUTH_LOCAL_VERIFY=true
# only for projects still signing with the legacy HS256 JWT secret (Project Settings > JWT Keys).
# secret like the service role key - never in the frontend
SUPABASE_JWT_SECRET=

# true = skip Gemini and answer from src/mocks
USE_MOCK_AI=false
# let Gemini use Google Search when our TCAS table has nothing (costs extra per grounded call)
TCAS_WEB_SEARCH=true

# rate limits
RATE_LIMIT_GENERAL_PER_15MIN=100
RATE_LIMIT_AI_PER_HOUR=20
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_AUTH_PER_15MIN=10
RATE_LIMIT_AUTH_IP_PER_15MIN=100
RATE_LIMIT_IP_PER_15MIN=1500
# open house: everyone on the venue Wi-Fi shares one public IP. list it here (comma list, CIDR ok)
# and per-IP limits (sign-up, demo, login per IP, flood guard) are multiplied for it
RATE_LIMIT_SHARED_IPS=
RATE_LIMIT_SHARED_MULTIPLIER=30
# hard cap on AI calls for the whole app per day (Bangkok time)
AI_DAILY_LIMIT=1000
# Gemini down / out of quota / daily cap hit -> answer with the student's last result or a labelled sample
AI_FALLBACK=true
# ping <url>/api/health every 10 min so a free host doesn't sleep (your backend's public url)
# KEEP_ALIVE_URL=https://pathfinder-api.onrender.com

# where the reset link in the email lands. defaults to FRONTEND_URL/ (the index page opens the new-password form)
# PASSWORD_RESET_REDIRECT_URL=http://localhost:4000/

# bump this when the terms / privacy policy change -> users get asked to accept again
TERMS_VERSION=1.0

# /api/stats hides any group smaller than this (so nobody can be singled out)
STATS_MIN_GROUP=3

# QR share links (default FRONTEND_URL/share.html?t={token}) expire after SHARE_DAYS.
# {token} marks where the token goes; without it the token is appended as /<token>
# SHARE_BASE_URL=https://pathfinder.example.com/share.html?t={token}
SHARE_DAYS=30

# "Demo Student" button: throwaway accounts with sample data
DEMO_LOGIN=true
DEMO_TTL_HOURS=6
DEMO_DAILY_LIMIT=300
RATE_LIMIT_DEMO_PER_HOUR=10

# optional: report 5xx errors to Sentry (https://sentry.io > project > Client Keys (DSN))
SENTRY_DSN=
