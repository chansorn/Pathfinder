{
  "name": "pathfinder-backend",
  "version": "1.0.0",
  "description": "PathFinder API - แนะแนวและวางแผนเรียนต่อด้วย AI สำหรับนักเรียน ม.ปลาย (TCAS)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:all": "npm test && npm run smoke:frontend",
    "smoke:frontend": "node scripts/frontend-smoke.mjs",
    "tcas:import": "node scripts/import-tcas.js",
    "tcas:cutoffs": "node scripts/import-cutoffs.js",
    "build:css": "tailwindcss -c \"../frontend/UI/PC UI/tailwind.build.cjs\" -i \"../frontend/UI/PC UI/css/tailwind.src.css\" -o \"../frontend/UI/PC UI/css/tailwind.css\" --minify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@sentry/node": "^11.17.0",
    "@supabase/supabase-js": "^2.119.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "nodemon": "^3.1.14",
    "tailwindcss": "^3.4.17"
  }
}
